{
  "title": "PostLogin",
  "type": "object",
  "properties": {
    "document_number": {
      "type": "string",
      "pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255
    }
  },
  "required": [
    "document_number",
    "password"
  ],
  "additionalProperties": false
}