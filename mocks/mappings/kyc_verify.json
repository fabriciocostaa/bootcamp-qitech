{
  "request": {
    "method": "POST",
    "urlPath": "/kyc/verify",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.cpf"
      },
      {
        "matchesJsonPath": "$.full_name"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "approved",
      "provider": "Federal_Database_Mock",
      "message": "Identidade confirmada com sucesso."
    }
  }
}